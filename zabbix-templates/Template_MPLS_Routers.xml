<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>6.0</version>
    <date>2026-06-17T15:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Network devices</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template MPLS Routers</template>
            <name>Template MPLS Routers</name>
            <description>Template básico para monitoreo de routers MPLS con ICMP.</description>
            <groups>
                <group>
                    <name>Templates/Network devices</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>ICMP</name>
                </application>
            </applications>
            <items>
                <item>
                    <name>ICMP Ping</name>
                    <key>icmpping</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>3</value_type>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>{HOST.NAME} no responde al ICMP ping</name>
                            <expression>{ITEM.LASTVALUE()}=0</expression>
                            <priority>3</priority>
                            <description>El host no está respondiendo a las solicitudes de ping ICMP.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>ICMP Latencia</name>
                    <key>icmppingsec</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>0</value_type>
                    <units>s</units>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>Alta latencia ICMP en {HOST.NAME}</name>
                            <expression>{ITEM.LASTVALUE()}>0.1</expression>
                            <priority>2</priority>
                            <description>La latencia del ping ICMP a {HOST.NAME} es superior a 100ms.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>ICMP Pérdida de Paquetes</name>
                    <key>icmppingloss</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>0</value_type>
                    <units>%</units>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>Pérdida de paquetes ICMP alta en {HOST.NAME}</name>
                            <expression>{ITEM.LASTVALUE()}>20</expression>
                            <priority>3</priority>
                            <description>Se está experimentando una pérdida de paquetes ICMP superior al 20% a {HOST.NAME}.</description>
                        </trigger>
                    </triggers>
                </item>
            </items>
        </template>
    </templates>
</zabbix_export>