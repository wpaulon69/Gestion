<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>6.0</version>
    <date>2026-06-17T15:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Network devices</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template Red Core Switches</template>
            <name>Template Red Core Switches</name>
            <description>Template para switches de red core con monitoreo STP, interfaces y errores.</description>
            <groups>
                <group>
                    <name>Templates/Network devices</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>STP</name>
                </application>
                <application>
                    <name>Interfaces</name>
                </application>
                <application>
                    <name>ICMP</name>
                </application>
            </applications>
            <items>
                <item>
                    <name>STP Topología Cambios (dot1dStpTopChanges)</name>
                    <key>net.if.stp.tc[total]</key>
                    <delay>1m</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>0</value_type>
                    <units>cambios</units>
                    <applications>
                        <application>
                            <name>STP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>Demasiados cambios de topología STP en {HOST.NAME}</name>
                            <expression>{ITEM.LASTVALUE()}>3 and {ITEM.AGE()}&lt;{#TRIGGER.VALUE}</expression>
                            <priority>4</priority>
                            <description>Detectado un número inusualmente alto de cambios de topología STP, lo que podría indicar inestabilidad en la red.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>ICMP Ping</name>
                    <key>icmpping</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>3</value_type>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>{HOST.NAME} no responde al ICMP ping</name>
                            <expression>{ITEM.LASTVALUE()}=0</expression>
                            <priority>3</priority>
                            <description>El host no está respondiendo a las solicitudes de ping ICMP.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>ICMP Latencia</name>
                    <key>icmppingsec</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>0</value_type>
                    <units>s</units>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>Alta latencia ICMP en {HOST.NAME}</name>
                            <expression>{ITEM.LASTVALUE()}>0.1</expression>
                            <priority>2</priority>
                            <description>La latencia del ping ICMP a {HOST.NAME} es superior a 100ms.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>ICMP Pérdida de Paquetes</name>
                    <key>icmppingloss</key>
                    <delay>30s</delay>
                    <history>7d</history>
                    <trends>365d</trends>
                    <value_type>0</value_type>
                    <units>%</units>
                    <applications>
                        <application>
                            <name>ICMP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <name>Pérdida de paquetes ICMP alta en {HOST.NAME}</name>
                            <expression>{ITEM.LASTVALUE()}>20</expression>
                            <priority>3</priority>
                            <description>Se está experimentando una pérdida de paquetes ICMP superior al 20% a {HOST.NAME}.</description>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <name>Descubrimiento de Interfaces de Red</name>
                    <key>net.if.discovery</key>
                    <delay>1h</delay>
                    <item_prototypes>
                        <item_prototype>
                            <name>Tráfico de entrada en interfaz {#IFNAME}</name>
                            <key>net.if.in[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>0</value_type>
                            <units>bps</units>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>Tráfico de salida en interfaz {#IFNAME}</name>
                            <key>net.if.out[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>0</value_type>
                            <units>bps</units>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>Errores de entrada en interfaz {#IFNAME}</name>
                            <key>net.if.in.errors[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>3</value_type>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                            <triggers>
                                <trigger>
                                    <name>Errores de entrada altos en {#IFNAME} en {HOST.NAME}</name>
                                    <expression>{ITEM.LASTVALUE()}>0</expression>
                                    <priority>2</priority>
                                    <description>Se están detectando errores de entrada en la interfaz {#IFNAME}.</description>
                                </trigger>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <name>Errores de salida en interfaz {#IFNAME}</name>
                            <key>net.if.out.errors[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>3</value_type>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                            <triggers>
                                <trigger>
                                    <name>Errores de salida altos en {#IFNAME} en {HOST.NAME}</name>
                                    <expression>{ITEM.LASTVALUE()}>0</expression>
                                    <priority>2</priority>
                                    <description>Se están detectando errores de salida en la interfaz {#IFNAME}.</description>
                                </trigger>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <name>Paquetes Broadcast de entrada en interfaz {#IFNAME}</name>
                            <key>net.if.in.broadcast[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>3</value_type>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>Paquetes Multicast de entrada en interfaz {#IFNAME}</name>
                            <key>net.if.in.multicast[{#IFNAME}]</key>
                            <delay>1m</delay>
                            <history>7d</history>
                            <trends>365d</trends>
                            <value_type>3</value_type>
                            <applications>
                                <application>
                                    <name>Interfaces</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
    <macros>
        <macro>
            <macro>{$SNMP_COMMUNITY}</macro>
            <value>public</value>
        </macro>
    </macros>
</zabbix_export>